    "settings.banner.ephemeralTitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes won't be saved"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本次修改不会保存"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本次修改不會儲存"
          }
        }
      }
    },
    "settings.banner.ephemeralBody" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The local database could not be opened. To avoid overwriting it, this session keeps data in memory only; it disappears when the app closes. Restart the app, or import a backup once storage works again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地数据库无法打开。为避免覆盖原数据，本次启动只把数据放在内存里，关闭 App 后不会保留。请重启 App，或在存储恢复后导入备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本機資料庫無法開啟。為避免覆蓋原有資料，本次啟動只把資料放在記憶體中，關閉 App 後不會保留。請重新啟動 App，或在儲存恢復後匯入備份。"
          }
        }
      }
    },
    "settings.banner.deviceTitle" : {
      "localizations" : {
        "en" : {
