    "settings.pro.legal.agree" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By subscribing, you agree to our"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "订阅即表示您同意我们的"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訂閱即表示您同意我們的"
          }
        }
      }
    },
    "settings.pro.legal.body" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payment will be charged to your Apple ID account upon confirmation of purchase. Subscription automatically renews unless auto-renew is turned off at least 24 hours before the end of the current period. Your account will be charged for renewal within 24 hours prior to the end of the current period. You can manage and cancel your subscriptions in your App Store account settings."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "购买确认后将通过您的 Apple ID 扣款。除非在当前周期结束前至少 24 小时关闭自动续订，否则订阅会自动续订。当前周期结束前 24 小时内会从您的账户扣款续订。您可在 App Store 账户设置中管理和取消订阅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購買確認後將透過您的 Apple ID 扣款。除非在當前週期結束前至少 24 小時關閉自動續訂，否則訂閱會自動續訂。當前週期結束前 24 小時內會從您的帳戶扣款續訂。您可在 App Store 帳戶設定中管理和取消訂閱。"
          }
        }
      }
    },
    "settings.pro.lifetime.legal.body" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lifetime plan is a one-time payment with no auto-renewal. Restore it on a new device with Restore Purchases."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久买断为一次性付款，不自动续订。换设备时可通过「恢复购买」找回。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久買斷為一次性付款，不自動續訂。換裝置時可透過「恢復購買」找回。"
          }
        }
      }
    },
