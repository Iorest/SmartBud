    "settings.import.allSkipped" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing new — every record was already on this device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有新增记录，备份里的内容本机都有了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有新增記錄，備份裡的內容本機都有了。"
          }
        }
      }
    },
    "OK" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OK"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好"
          }
        }
      }
    },
    "Add an exchange rate for %@ first (Settings → Currency → Exchange Rates), then switch the base currency." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add an exchange rate for %@ first (Settings → Currency → Exchange Rates), then switch the base currency."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先在「设置 → 货币 → 汇率」里添加 %@ 的汇率，再切换基准货币。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先在「設定 → 貨幣 → 匯率」裡新增 %@ 的匯率，再切換基準貨幣。"
          }
        }
      }
    },
    "Archive this account?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archive this account?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "归档这个账户？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歸檔這個帳戶？"
          }
        }
      }
    },
    "Could not switch base currency" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not switch base currency"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法切换基准货币"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法切換基準貨幣"
          }
        }
      }
    },
    "Every stored amount will be converted at 1 %@ = %@ %@ (%lld records) and then stay fixed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every stored amount will be converted at 1 %@ = %@ %@ (%lld records) and then stay fixed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有已存金额会按 1 %@ = %@ %@ 折算（共 %lld 条记录），之后不再变化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有已存金額會按 1 %@ = %@ %@ 折算（共 %lld 筆記錄），之後不再變化。"
          }
        }
      }
    },
    "Switch base currency?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch base currency?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换基准货币？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切換基準貨幣？"
          }
        }
      }
    },
    "The switch could not be saved. Nothing was changed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The switch could not be saved. Nothing was changed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换未能保存，数据没有变化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切換未能儲存，資料沒有變化。"
          }
        }
      }
    },
    "This backup was recorded in %@ but this device uses %@. Switch the base currency first, or erase the data and import again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This backup was recorded in %@ but this device uses %@. Switch the base currency first, or erase the data and import again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这份备份使用 %@ 记账，本机使用 %@。请先切换基准货币，或清空数据后再导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這份備份使用 %@ 記帳，本機使用 %@。請先切換基準貨幣，或清空資料後再匯入。"
          }
        }
      }
    },
    "This is already your base currency." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is already your base currency."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这已经是你的基准货币。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這已經是您的基準貨幣。"
          }
        }
      }
    },
    "“%@” still holds %@. Archived accounts are left out of the total balance and out of the account picker. Transfer the money out first if it is still in use." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” still holds %@. Archived accounts are left out of the total balance and out of the account picker. Transfer the money out first if it is still in use."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”里还有 %@。归档后不会计入总资产，也不会再出现在记账页的账户列表里。如果这笔钱还在用，建议先转出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」裡還有 %@。歸檔後不會計入總資產，也不會再出現在記帳頁的帳戶列表裡。如果這筆錢還在用，建議先轉出。"
          }
        }
      }
    },
