    "The 'Excessive' mode makes the entire numpad haptic." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"过度\"模式使整个数字键盘具有触觉反馈。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「過度」模式使整個數字鍵盤具有觸覺回饋。"
          }
        }
      }
    },
    "The budget will periodically refresh according to your preference." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The budget will periodically refresh according to your preference."
